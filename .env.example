# MongoDB
MONGO_MODE='managed' | 'external'
MONGO_USERNAME=''
MONGO_PASSWORD=''
MONGO_DATABASE=''
MONGO_HOST='localhost'
MONGO_PORT='27017'
MONGO_PARAMS=''

# Redis (cache) and BullMQ (queue)
# Shared provisioning mode: 'managed' spins up an instance from Node, 'external'
# connects to an already-running Redis. The queue uses a separate BULLMQ_REDIS_*
# prefix because BullMQ requires maxmemory-policy=noeviction.
REDIS_MODE='managed' | 'external'
REDIS_HOST='localhost'
REDIS_PORT='6379'
REDIS_USERNAME=''
REDIS_PASSWORD=''
REDIS_DATABASE='0'
REDIS_CONNECT_TIMEOUT_MS='5000'
BULLMQ_REDIS_HOST='localhost'
BULLMQ_REDIS_PORT='6379'
BULLMQ_REDIS_USERNAME=''
BULLMQ_REDIS_PASSWORD=''
BULLMQ_REDIS_DATABASE='0'
BULLMQ_REDIS_CONNECT_TIMEOUT_MS='5000'

# Environment
NODE_ENV='dev' | 'testing' | 'production'

# API
API_ENV='development' | 'staging' | 'production'
API_HOST=http://localhost
API_PORT=3333

# Logger
LOGGER_ENABLED='true' | 'false'
LOGGER_LEVEL='debug' | 'info' | 'error'

# Storage
STORAGE_TYPE="local" | "s3"

# AWS / Cloudflare R2
AWS_S3_BUCKET_NAME=''
AWS_ACCESS_KEY_ID=''
AWS_SECRET_ACCESS_KEY=''
AWS_DEFAULT_REGION=''
AWS_S3_ENDPOINT=''
AWS_S3_PUBLIC_URL=''

# Auth secrets
# Signing secrets. In production each must be at least 32 chars and all three distinct.
COOKIE_SECRET=''
ACCESS_TOKEN_SECRET=''
REFRESH_TOKEN_SECRET=''
# Token lifetimes in seconds. Production caps: access <= 3600, refresh <= 2592000, verification <= 86400.
ACCESS_TOKEN_EXPIRES_IN_SECONDS=900
REFRESH_TOKEN_EXPIRES_IN_SECONDS=1209600
VERIFICATION_TOKEN_EXPIRES_IN_SECONDS=3600
# Email verification / password reset token size (hex chars). Must be even; in production in [32, 128].
VERIFICATION_TOKEN_SIZE=64
# bcrypt cost factor. In production in [12, 15].
PASSWORD_HASH_ROUNDS=12


# BullMQ Worker
EMAIL_WORKER_CONCURRENCY=5

# SMTP
# Start MailDev with `npm run smtp`; its inbox is available at http://localhost:1080.
# Use "localhost" when the application runs on the host.
# Docker Compose overrides this value with the "mailpit" service hostname.
SMTP_DOMAIN='drunkflavor.com'
SMTP_HOST='localhost'
SMTP_PORT=1025
SMTP_USERNAME=''
SMTP_PASSWORD=''
# Client
# Required in production. Used to build absolute links in account emails (email verification / password reset).
CLIENT_BASE_URL=http://localhost:3000

# Google OAuth
# OAuth 2.0 client ID used as the expected audience when verifying Google ID tokens.
# Required (non-empty) in development and production.
GOOGLE_CLIENT_ID=''
