{
	"name": "drunk-flavor-back",
	"version": "2.0.0",
	"description": "",
	"main": "server.ts",
	"type": "module",
	"scripts": {
		"format": "prettier --write 'src/**/*.ts'",
		"format:check": "prettier --check 'src/**/*.ts'",
		"format:staged": "pretty-quick --staged",
		"lint": "eslint .",
		"lint:fix": "eslint . --fix",
		"lint:staged": "lint-staged",
		"typecheck": "tsc --noEmit",
		"prepare": "husky",
		"clean": "rm -Rf dist",
		"start": "NODE_ENV=production node dist/server.js",
		"dev": "tsx src/server.ts",
		"dev:watch": "tsx watch src/server.ts",
		"worker:dev": "tsx src/worker.ts",
		"worker:dev:watch": "tsx watch src/worker.ts",
		"worker": "NODE_ENV=production node dist/worker.js",
		"worker:build": "tsup src/worker.ts",
		"smtp": "tsx scripts/run-smtp.ts",
		"build": "tsup src/server.ts",
		"test": "NODE_ENV=testing vitest run -c vitest.config.ts",
		"test:watch": "NODE_ENV=testing vitest -c vitest.config.ts",
		"test:coverage": "NODE_ENV=testing vitest run -c vitest.config.ts --coverage",
		"test:coverage:blob": "NODE_ENV=testing vitest run -c vitest.config.ts --coverage --reporter=blob --outputFile=.vitest/blob/unit.json",
		"test:coverage:all": "npm run test:coverage:blob && npm run test:int:coverage:blob && NODE_ENV=testing vitest run --merge-reports=.vitest/blob --coverage -c vitest-merge.config.ts",
		"test:int": "NODE_ENV=testing vitest run -c vitest-integration.config.ts",
		"test:int:coverage": "NODE_ENV=testing vitest run -c vitest-integration.config.ts --coverage",
		"test:int:coverage:blob": "NODE_ENV=testing vitest run -c vitest-integration.config.ts --coverage --reporter=blob --outputFile=.vitest/blob/integration.json",
		"test:int:watch": "NODE_ENV=testing vitest -c vitest-integration.config.ts",
		"test:e2e": "tsx scripts/run-e2e.ts",
		"test:e2e:run": "NODE_ENV=e2e vitest run -c vitest-e2e.config.ts",
		"test:e2e:watch": "npm run test:e2e -- --watch",
		"test:template": "NODE_ENV=testing vitest run -c vitest.config.ts 'src/shared/providers/template/implementations/views/'",
		"test:template:watch": "NODE_ENV=testing vitest -c vitest.config.ts 'src/shared/providers/template/implementations/views/'",
		"test:template:output": "NODE_ENV=testing STORE_TEMPLATES=true vitest run -c vitest.config.ts 'src/shared/providers/template/implementations/views/'",
		"test:template:output:watch": "NODE_ENV=testing STORE_TEMPLATES=true vitest -c vitest.config.ts 'src/shared/providers/template/implementations/views/'",
		"generate-secret-key": "npx @fastify/secure-session > secret-key",
		"seed:drinks": "tsx seed/drinks",
		"seed:admin": "tsx seed/accounts/admin.ts",
		"reconcile:drink-ratings": "tsx scripts/reconcile-drink-ratings.ts"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "3.1159.0",
		"@casl/ability": "7.0.2",
		"@fastify/cookie": "11.1.3",
		"@fastify/cors": "11.3.1",
		"@fastify/helmet": "13.2.0",
		"@fastify/jwt": "10.2.5",
		"@fastify/multipart": "10.1.4",
		"@fastify/rate-limit": "11.2.1",
		"@fastify/secure-session": "8.4.1",
		"@fastify/static": "10.1.8",
		"@fastify/swagger": "9.9.2",
		"@fastify/swagger-ui": "6.1.2",
		"@types/node-polyglot": "2.5.0",
		"bcrypt": "6.0.0",
		"bullmq": "6.5.1",
		"dayjs": "1.11.23",
		"dotenv": "18.0.9",
		"fastify": "5.12.7",
		"fastify-i18n": "3.0.0",
		"fastify-type-provider-zod": "7.0.0",
		"google-auth-library": "11.3.1",
		"mjml": "5.4.1",
		"mongodb": "7.7.0",
		"mongoose": "9.11.4",
		"nodemailer": "10.1.7",
		"pino": "10.4.0",
		"pino-http": "11.0.0",
		"pino-pretty": "13.2.0",
		"redis": "6.3.0",
		"ts-pattern": "5.9.2",
		"zod": "4.6.7"
	},
	"devDependencies": {
		"@types/bcrypt": "6.0.0",
		"@types/mjml": "5.0.0",
		"@types/node": "24.19.2",
		"@types/nodemailer": "8.0.2",
		"@types/semver": "7.8.0",
		"@types/supertest": "7.2.1",
		"@types/tmp": "0.2.6",
		"@vitest/coverage-v8": "5.0.5",
		"@vitest/eslint-plugin": "1.6.28",
		"dotenv-cli": "11.0.0",
		"eslint": "10.13.0",
		"eslint-config-prettier": "10.1.8",
		"husky": "9.1.7",
		"lint-staged": "17.6.0",
		"maildev": "3.0.0",
		"mongodb-memory-server": "11.3.0",
		"prettier": "3.9.10",
		"pretty-quick": "4.2.2",
		"redis-memory-server": "0.17.1",
		"supertest": "7.3.1",
		"tsup": "9.0.0",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vitest": "5.0.5"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/juanlessa/drunk-flavor-back"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"author": "Juan Lessa",
	"license": "ISC",
	"homepage": "https://github.com/juanlessa/drunk-flavor-back#readme",
	"bugs": {
		"url": "https://github.com/juanlessa/drunk-flavor-back/issues"
	},
	"keywords": [
		"DrunkFlavor",
		"Drink",
		"recipes",
		"Fastify",
		"Node.js",
		"Backend",
		"MongoDB",
		"Vitest",
		"Beverage",
		"preparation",
		"Cocktails",
		"Mixology",
		"API",
		"Recipe",
		"management",
		"Drinks",
		"database",
		"Web",
		"development"
	]
}
